# Machine-specific settings. Copy this file to .env in the repository root and fill it in.
# Never commit .env: it holds keys. Method settings (model, thresholds, maximum tokens) are not set here; they are command-line flags whose defaults are pinned to the released runs.
# Each command asks only for the keys it uses, and stops with a pointer here if one is unset.

# The folder that holds the data kept outside git (docs/setup/data-root.md), for example DATA_ROOT=/path/to/mbdef-data-root. `mbdef data fetch` fills it, with the two datasets MBDef and MBDef-Gold from Hugging Face among the rest.
DATA_ROOT=

# Optional: a Hugging Face key, which `data fetch` sends when it downloads MBDef and MBDef-Gold. The public datasets need none; a private copy of them does.
HF_TOKEN=

# The language-model endpoint and its key (a local vLLM server needs no real key). Read by `mbdef extract run`, `extract verify` and `relevance classify`, except when they replay recorded responses (--replay).
DSPY_API_BASE=http://localhost:8000/v1
DSPY_API_KEY=EMPTY

# The device of the two scoring models (BGE and the entailment model of `mbdef evaluate score` and `evaluate heldout`, docs/step-3-extraction/evaluate.md) and of the relevance filter's BGE (`extract filter`, docs/step-3-extraction/extract.md): cpu, cuda or auto.
SCIDEF_NLI_DEVICE=auto

# The contact address Unpaywall asks for in each request (`collect open-access` needs it).
UNPAYWALL_EMAIL=

# Optional: an OpenAlex API key gives `collect openalex` and tutorial 05 (research disciplines) a larger daily budget.
OPENALEX_API_KEY=

# Optional: the contact address for Crossref's polite pool (`collect crossref`, and the DOI check of `collect semantic-scholar`); UNPAYWALL_EMAIL is used if this is unset.
CROSSREF_MAILTO=

# Optional: a Semantic Scholar API key (`collect semantic-scholar`, `collect semantic-scholar-doi`); without one, their requests share Semantic Scholar's public rate limit.
SEMANTIC_SCHOLAR_API_KEY=

# Optional: a Slurm cluster (docs/setup/cluster.md); every step also runs on one machine without one. `mbdef cluster render --site X` needs the keys of site X only, and stops with a pointer here if one is unset. The files in cluster/ hold what a cluster is (partitions, GPUs, QOS); who you are on it and where your files live are set here, one pair of keys per site file, named after it: CLUSTER_EXAMPLE_* for cluster/example.toml.
#
# CLUSTER_<SITE>_ROOT: the one folder that holds everything of yours on that cluster: repo/ (a checkout), venv/, hf-cache/, data-root/ and logs/, as an absolute path on the cluster, for example /projects/<your project>/taxonomy.
# CLUSTER_<SITE>_ACCOUNT: the project account that Slurm bills the job to, for a site file that says `needs_account = true` (ask the project's manager for its name).
CLUSTER_EXAMPLE_ROOT=
CLUSTER_EXAMPLE_ACCOUNT=
